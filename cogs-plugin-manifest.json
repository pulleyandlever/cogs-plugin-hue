{
  "name": "Hue Control",
  "version": "0.3.0",
  "description": "Reliable Hue controller with cue queueing and status reporting",
  "icon": "lightbulb-on",
  "config": [
    { "name": "API Key", "value": { "type": "string" } },
    {
      "name": "Bridge IP Address",
      "value": { "type": "string" }
    },
    {
      "name": "Default Scene",
      "value": { "type": "string" }
    },
    {
      "name": "Transition Time (Project Default)",
      "value": { "type": "number", "integer": true, "min": 0 }
    }
  ],
  "events": {
    "fromCogs": [
      { "name": "Show Scene", "value": { "type": "string" } },
      { "name": "Start Flicker", "value": { "type": "string" } },
      { "name": "Stop Flicker", "value": { "type": "option", "options": ["stop"] } },
      { "name": "Start Colorloop", "value": { "type": "string" } },
      { "name": "Start Party", "value": { "type": "string" } },
      { "name": "Stop Effect", "value": { "type": "string" } }
    ],
    "toCogs": [
      { "name": "Scene Shown", "value": { "type": "string" } },
      { "name": "Cue Failed", "value": { "type": "string" } },
      { "name": "Bridge Online", "value": { "type": "boolean" } }
    ]
  }
}
